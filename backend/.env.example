# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wb_tracker
DB_USER=postgres
DB_PASSWORD=your_password_here
# Or provide a full connection string:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Connection pool
DB_POOL_MIN=1
DB_POOL_MAX=10

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# Authentication
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_bcrypt_hash
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_MINUTES=480

# Password reset / email. For local development, use the Mailpit service in
# docker-compose.yml (SMTP_HOST=localhost, SMTP_PORT=1025, STARTTLS disabled).
# Public URL used to build links inside emails (must point at the frontend).
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WB Tracker <noreply@localhost>
SMTP_STARTTLS=0

# External AI services
# GEMINI_API_KEY=your-gemini-key
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
